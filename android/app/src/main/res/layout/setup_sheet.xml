<?xml version="1.0" encoding="utf-8"?>
<!-- SetupSheet (UI-DESIGN §6.4) の入れ物。行は item_setup_row.xml を動的に足す。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nocturne_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setup_title"
        android:textColor="@color/nocturne_text"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="@string/setup_desc"
        android:textColor="@color/nocturne_text_dim"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/setupRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetupClose"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/setup_close"
        android:textColor="@color/nocturne_accent_text" />
</LinearLayout>
