<?xml version="1.0" encoding="utf-8"?>
<!-- UI-DESIGN §1.4 設定。接続/SIP アカウントはインライン入力 (ダイアログ廃止)。
     入力は欄から離れた時点で欄ごとに保存し、必須チェックは「開始」時にまとめて行う。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nocturne_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. 状態カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nocturne_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nocturne_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvConnTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_conn_title_offline"
                            android:textColor="@color/nocturne_text"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvConnDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="2dp"
                            android:text="@string/common_unset"
                            android:textColor="@color/nocturne_text_dim"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartStop"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_conn_start"
                        android:textColor="@color/nocturne_accent_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHubStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/settings_status_initial"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp" />

                <!-- 未入力の必須項目 (接続できない理由) をここにまとめて出す。
                     個々の入力欄では弾かない (相互に必須で入力不能になるため)。 -->
                <TextView
                    android:id="@+id/tvSetupHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text=""
                    android:textColor="@color/nocturne_missed"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1b. セットアップカード (§6.4。不足が無いときは GONE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/nocturne_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nocturne_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSetupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/nocturne_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvSetupLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetupOpen"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_card_open"
                    android:textColor="@color/nocturne_accent_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. 接続カード (インライン入力。欄から離れた時点で保存する) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nocturne_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nocturne_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sec_conn"
                    android:textColor="@color/nocturne_text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/settings_conn_note"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRelayUrl"
                    style="@style/Widget.SipBridge.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_row_relay_url"
                    app:helperText="@string/settings_hint_relay_url"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRelayUrl"
                        style="@style/Widget.SipBridge.TextInput.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAccessId"
                    style="@style/Widget.SipBridge.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_row_access_id">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAccessId"
                        style="@style/Widget.SipBridge.TextInput.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:inputType="textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAccessSecret"
                    style="@style/Widget.SipBridge.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_row_access_secret"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAccessSecret"
                        style="@style/Widget.SipBridge.TextInput.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDevToken"
                    style="@style/Widget.SipBridge.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_row_dev_token"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/settings_hint_dev_token"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDevToken"
                        style="@style/Widget.SipBridge.TextInput.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. SIP アカウントカード (インライン入力) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nocturne_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nocturne_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sec_sip"
                    android:textColor="@color/nocturne_text"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSipUser"
                    style="@style/Widget.SipBridge.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_row_sip_user">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSipUser"
                        style="@style/Widget.SipBridge.TextInput.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:inputType="textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSipPassword"
                    style="@style/Widget.SipBridge.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_row_sip_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSipPassword"
                        style="@style/Widget.SipBridge.TextInput.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSipDisplay"
                    style="@style/Widget.SipBridge.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_row_sip_display">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSipDisplay"
                        style="@style/Widget.SipBridge.TextInput.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/settings_sip_note"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. 動作カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nocturne_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nocturne_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sec_behavior"
                    android:textColor="@color/nocturne_text"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModePersistent"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_mode_persistent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModePush"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_mode_push" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/tvModeDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/settings_mode_desc_persistent"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutostart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_sw_autostart"
                    android:textColor="@color/nocturne_text" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sw_overlay"
                    android:textColor="@color/nocturne_text" />

                <!-- オーバーレイ ON なのに権限が無い状態 (バブル・通話中ピルが出ない) を
                     その場で気付けるようにする。タップで権限画面へ。 -->
                <TextView
                    android:id="@+id/tvOverlayWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/settings_overlay_warn"
                    android:textColor="@color/nocturne_missed"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSpeaker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sw_speaker"
                    android:textColor="@color/nocturne_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="@string/settings_sw_speaker_desc"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swDeviceContacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_sw_device_contacts"
                    android:textColor="@color/nocturne_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="@string/settings_sw_device_contacts_desc"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swQuiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_sw_quiet"
                    android:textColor="@color/nocturne_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="@string/settings_sw_quiet_desc"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. 音声カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nocturne_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nocturne_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sec_audio"
                    android:textColor="@color/nocturne_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvMicGain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/settings_gain_placeholder"
                    android:textColor="@color/nocturne_text"
                    android:textSize="14sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderMicGain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. 権限カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nocturne_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nocturne_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sec_permission"
                    android:textColor="@color/nocturne_text"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/rowPermOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_row_perm_overlay"
                        android:textColor="@color/nocturne_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPermOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_perm_denied"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowPermBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_row_perm_battery"
                        android:textColor="@color/nocturne_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPermBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_perm_not_excluded"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowPermNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_row_perm_notification"
                        android:textColor="@color/nocturne_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPermNotification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_perm_denied"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowPermFullscreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_row_perm_fullscreen"
                        android:textColor="@color/nocturne_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPermFullscreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_perm_na"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowPermMic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_row_perm_mic"
                        android:textColor="@color/nocturne_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPermMic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_perm_denied"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowPermHibernation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_row_perm_hibernation"
                        android:textColor="@color/nocturne_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPermHibernation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_perm_denied"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Samsung 端末のみ: One UI のスリープ案内 (§6.0 B。API では取れないため案内行だけ) -->
                <TextView
                    android:id="@+id/tvSamsungGuide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/settings_samsung_guide"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7. テスト -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestIncoming"
