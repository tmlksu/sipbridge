<?xml version="1.0" encoding="utf-8"?>
<!-- UI-DESIGN §4 キーパッド (横)。左に番号表示+発信ボタン、右に 3x4 キー。
     縦版 (layout/fragment_keypad.xml) と view ID を揃えること。
     480dp 高さで主要操作が見えるようスクロール無しの固定配置。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nocturne_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStatusPill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/pill_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:padding="8dp"
            android:text="@string/keypad_status_offline"
            android:textColor="@color/nocturne_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvModeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/pill_bg"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/keypad_mode_persistent"
            android:textColor="@color/nocturne_text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvInCallPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/pill_call"
            android:gravity="center"
            android:padding="10dp"
            android:text="📞 00:00"
            android:textColor="@color/nocturne_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 左: 番号表示+発信 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="48dp"
                android:text=""
                android:textColor="@color/nocturne_text"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/tvCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="4dp"
                android:text="@string/keypad_hint_empty"
                android:textColor="@color/nocturne_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="56dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="32dp"
                    app:icon="@drawable/ic_call"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="28dp"
                    android:contentDescription="@string/call_dial_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackToCall"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/keypad_back_to_call"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/nocturne_surface_hi"
                    app:cornerRadius="32dp"
                    app:icon="@drawable/ic_backspace"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/nocturne_text"
                    app:strokeColor="@color/nocturne_border"
                    app:strokeWidth="1dp"
                    android:contentDescription="@string/call_delete_desc" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右: 3x4 キー (KeypadFragment がコードで組み立てる) -->
        <GridLayout
            android:id="@+id/keypadGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4" />
    </LinearLayout>
</LinearLayout>
