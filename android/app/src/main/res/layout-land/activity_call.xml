<?xml version="1.0" encoding="utf-8"?>
<!-- UI-DESIGN §4 通話画面 (横 960x480, Echo Show 5)。
     左半分にアバター+名前+番号+状態、右半分に操作ボタン。
     480dp 高さで主要操作が見えるようスクロール無しの固定配置。
     縦版 (layout/activity_call.xml) と view ID を揃えること。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCall"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nocturne_bg"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- 左半分: アバター+名前+番号+状態 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/call_caption_incoming"
            android:textColor="@color/nocturne_text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:text="?"
            android:textColor="@color/nocturne_accent_text"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:text="@string/call_unknown"
            android:textColor="@color/nocturne_text"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/nocturne_text_dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/call_state_initial"
            android:textColor="@color/nocturne_accent_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvEndToast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pill_bg"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/nocturne_text"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 右半分: 操作ボタン -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 着信中: 拒否 / 応答 -->
        <LinearLayout
            android:id="@+id/layoutIncoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingEnd="32dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReject"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:rotation="135"
                    android:text="📞"
                    android:textSize="28sp"
                    app:backgroundTint="@color/nocturne_neutral_btn"
                    app:cornerRadius="36dp"
                    android:contentDescription="@string/call_reject" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/call_reject"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="32dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnswer"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:text="📞"
                    android:textSize="28sp"
                    app:backgroundTint="@color/nocturne_accent"
                    app:cornerRadius="36dp"
                    android:contentDescription="@string/call_answer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/call_answer"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 発信中 (呼出中): 切断のみ -->
        <LinearLayout
            android:id="@+id/layoutOutgoing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDisconnect"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/call_disconnect"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:rotation="135"
                android:text="📞"
                android:textSize="28sp"
                app:backgroundTint="@color/nocturne_neutral_btn"
                app:cornerRadius="36dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/call_disconnect"
                android:textColor="@color/nocturne_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 通話中: 3x2 操作 + 終了 -->
        <LinearLayout
            android:id="@+id/layoutIncall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMute"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:text="🎙"
                        android:textSize="22sp"
                        app:backgroundTint="@color/nocturne_surface_hi"
                        app:cornerRadius="28dp"
                        app:strokeColor="@color/nocturne_border"
                        app:strokeWidth="1dp"
                        android:contentDescription="@string/call_mute" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_mute"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKeypad"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:text="🔢"
                        android:textSize="22sp"
                        app:backgroundTint="@color/nocturne_surface_hi"
                        app:cornerRadius="28dp"
                        app:strokeColor="@color/nocturne_border"
                        app:strokeWidth="1dp"
                        android:contentDescription="@string/call_keypad" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_keypad"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpeaker"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:text="🔊"
                        android:textSize="22sp"
                        app:backgroundTint="@color/nocturne_surface_hi"
                        app:cornerRadius="28dp"
                        app:strokeColor="@color/nocturne_border"
                        app:strokeWidth="1dp"
                        android:contentDescription="@string/call_speaker" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_speaker"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.35"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHold"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:enabled="false"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:text="⏸"
                        android:textSize="22sp"
                        app:backgroundTint="@color/nocturne_surface_hi"
                        app:cornerRadius="28dp"
                        app:strokeColor="@color/nocturne_border"
                        app:strokeWidth="1dp"
                        android:contentDescription="@string/call_hold_desc" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_hold"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.35"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddCall"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:enabled="false"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:text="＋"
                        android:textSize="22sp"
                        app:backgroundTint="@color/nocturne_surface_hi"
                        app:cornerRadius="28dp"
                        app:strokeColor="@color/nocturne_border"
                        app:strokeWidth="1dp"
                        android:contentDescription="@string/call_add_desc" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_add"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.35"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContacts"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:enabled="false"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:text="👤"
                        android:textSize="22sp"
                        app:backgroundTint="@color/nocturne_surface_hi"
                        app:cornerRadius="28dp"
                        app:strokeColor="@color/nocturne_border"
                        app:strokeWidth="1dp"
                        android:contentDescription="@string/call_contacts_desc" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_contacts"
                        android:textColor="@color/nocturne_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </GridLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnd"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:rotation="135"
                    android:text="📞"
                    android:textSize="28sp"
                    app:backgroundTint="@color/nocturne_neutral_btn"
                    app:cornerRadius="36dp"
                    android:contentDescription="@string/call_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/call_end"
                    android:textColor="@color/nocturne_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
