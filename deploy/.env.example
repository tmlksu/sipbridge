# sipbridge relay / cloudflared 用環境変数の雛形。
# 使い方: cp .env.example .env して値を埋める (.env は .gitignore 済み、commit 厳禁)。
# 対応する relay の設定読み込みは relay/internal/config (T1)。

# --- relay: 待ち受け ---
# relay が LISTEN するアドレス。cloudflared と同じホストで動かす前提なので
# 既定どおり 127.0.0.1 のままにすること (0.0.0.0 に開かない)。
LISTEN=127.0.0.1:8080

# --- relay: 認証モード ---
# cf-access = 本番 (Cloudflare Access の JWT を検証)。token = 開発用 (DEV_TOKEN 一致で許可)。
AUTH_MODE=cf-access
# Access のチームドメイン (JWKS 取得先 https://<この値>/cdn-cgi/access/certs に使う)。
CF_TEAM_DOMAIN=example.cloudflareaccess.com
# Access アプリケーションの AUD タグ (Zero Trust ダッシュボードで確認)。
CF_ACCESS_AUD=
# 開発用共有トークン。AUTH_MODE=token のときのみ使用。本番では空のまま。
DEV_TOKEN=

# --- relay: 対向 SIP サーバ (SIP 内線として REGISTER する先。LAN 内) ---
# Asterisk に限らず任意の SIP レジストラでよい。
#   Asterisk:        そのホストの LAN IP
#   ひかり電話 HGW:  HGW の LAN 側 IP (例 192.168.1.1)。内線番号/パスワードは
#                    HGW の「電話設定 > 内線設定」で払い出したものを使う
# 旧名 ASTERISK_HOST / ASTERISK_PORT も互換で読む (SIP_HOST/SIP_PORT が優先)。
SIP_HOST=192.168.1.10
SIP_PORT=5060
# SIP アカウント (内線) は v1.1 からアプリ側で設定する (sip_account)。
# 以下の 3 つは任意の「既定アカウント」で、設定するとアカウント未設定の端末が
# 接続時に暫定的にこの内線へ結び付く (旧アプリ互換)。アプリで設定するなら空でよい。
# 既定アカウントは relay 起動時に必ず REGISTER される。
SIP_USER=
SIP_PASSWORD=
SIP_DISPLAY=
# SDP/Contact に載せる自 IP。空なら自動検出。Docker host モードでは通常自動でよい。
# Asterisk と別セグメント越しの場合は LAN 側 IP を明示する。
LOCAL_IP=
# RTP 用 UDP ポート範囲。Asterisk 側の rtp.conf と重ならない範囲を選ぶ。
RTP_PORT_MIN=20000
RTP_PORT_MAX=20100
# バックエンド種別。sip = 本番 (sipgo)。fake = Asterisk 無しでの疎通確認用。
BACKEND=sip
# 通話中に WS が切れてから BYE するまでの猶予 (秒、1..300)。
# アプリの再接続 (バックオフ + Access/Tunnel ハンドシェイク) が収まる値にする。
RESUME_TIMEOUT_SEC=30

# --- relay: ログ・状態 ---
# debug|info|warn|error
LOG_LEVEL=info
# 状態ファイル (JSON, 0600): SIP アカウント / 端末とアカウントの結び付け /
# push トークンを保存する。compose では deploy/data がコンテナの
# /var/lib/sipbridge に bind mount される (パスはコンテナ内)。
# 旧名 PUSH_STATE_FILE も読む (旧形式のファイルは起動時に自動移行)。
STATE_FILE=/var/lib/sipbridge/state.json

# --- relay: FCM push (T5。Galaxy S25 など GMS 端末の起床用) ---
# サービスアカウント JSON のパス (コンテナ内)。ホストでは deploy/data/service-account.json に置く。
# リポジトリに置かない (.gitignore 済み)。
FCM_SERVICE_ACCOUNT_FILE=/var/lib/sipbridge/service-account.json
# FCM HTTP v1 のプロジェクト ID (メッセージ送信先 URL に使う)。
FCM_PROJECT_ID=

# --- cloudflared: Tunnel トークン ---
# Zero Trust ダッシュボードで Tunnel を作ったときに発行されるトークン。
TUNNEL_TOKEN=
